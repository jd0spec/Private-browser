{
  "manifest_version": 2,
  "name": "Synced Video Player",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "video_player@ahmad.gbrowser"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
